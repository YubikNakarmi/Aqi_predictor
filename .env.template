# Environment Configuration Template
# Copy this file to .env and fill in your own values

# ============================================
# API & Credentials
# ============================================
# OpenWeather API key for fetching weather data
OPEN_WEATHER_API_KEY=your_api_key_here

# ============================================
# Azure Storage Configuration
# ============================================
# Azure Blob Storage connection string
# Format: DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;...
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string_here

# MLflow artifact root in Azure Blob Storage
# Format: wasbs://container@storageaccount.blob.core.windows.net/
MLFLOW_ARTIFACT_ROOT=wasbs://container@youraccount.blob.core.windows.net/

# ============================================
# MySQL/Database Configuration
# ============================================
# MySQL host: use 'host.docker.internal' for local MySQL on host machine,
# or the service name if MySQL is in another container
MYSQL_HOST=host.docker.internal

# MySQL root/admin password
MYSQL_PW=your_mysql_password_here

# MySQL username
MYSQL_USER=root

# Full MySQL connection URL for MLflow backend store
# Format: mysql+pymysql://user:password@host:port/database_name
MYSQLURL=mysql+pymysql://root:your_mysql_password_here@host.docker.internal:3306/mlflow_backend

# Optuna database connection URL (for hyperparameter tuning)
# Format: mysql+pymysql://user:password@host:port/database_name
OPTUNA_PATH=mysql+pymysql://root:your_mysql_password_here@host.docker.internal:3306/Optuna_db

# ============================================
# MLflow Configuration
# ============================================
# MLflow tracking server URI
MLFLOW_TRACKING_URI=http://0.0.0.0:5000

# Path to store MLflow artifacts locally (if not using cloud storage)
ARTIFACTS_PATH=data/artifacts/

# ============================================
# Data & Model Configuration
# ============================================
# Forecast horizon in hours
HORIZON=24

# Train/validation/test split ratios
TRAIN_SPLIT=0.7
VAL_SPLIT=0.15
TEST_SPLIT=0.15

# Processed data directory path
DATA_PROCESSED_PATH=data/processed/hourly/us_paro_hourly/

# Predictions output directory
PREDICTIONS_DIR=data/predictions/hourly/us_paro_hourly/test/
