# Environment Configuration Template
# Copy this file to .env and fill in your own values

# ============================================
# API & Credentials
# ============================================
# OpenWeather API key for fetching weather data
OPEN_WEATHER_API_KEY=your_api_key_here

# ============================================
# Azure Storage Configuration
# ============================================
# MLflow artifact root in Azure Blob Storage
# Format: wasbs://container@storageaccount.blob.core.windows.net/
MLFLOW_ARTIFACT_ROOT=wasbs://container@youraccount.blob.core.windows.net/

# Azure Blob Storage connection string
# Format: DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;...
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string_here

# ============================================
# MySQL/Database Configuration
# ============================================
# MySQL host: use 'host.docker.internal' for local MySQL on host machine,
# or the service name if MySQL is in another container
MYSQL_HOST=host.docker.internal

# MySQL root/admin password
MYSQL_PW=your_mysql_password_here

# MySQL username
MYSQL_USER=root

# ============================================
# Airflow Configuration
# ============================================
# Airflow project directory (host path for volume mounts)
AIRFLOW_PROJ_DIR=/path/to/pypipeline

# ============================================
# Data & Model Configuration
# ============================================
# Forecast horizon in hours
HORIZON=24

# Train/validation/test split ratios
TRAIN_SPLIT=0.7
VAL_SPLIT=0.15
TEST_SPLIT=0.15

# Predictions output directory
PREDICTIONS_DIR=/data/predictions/hourly/us_paro_hourly/

# Path to store artifacts
ARTIFACTS_PATH=/data/artifacts/

# Processed data directory path
DATA_PROCESSED_PATH=/data/processed/hourly/us_paro_hourly/

# Station name identifier
STATION_NAME=us_paro_hourly

# ============================================
# Prediction Pipeline Paths
# ============================================
# Raw ingestion path for prediction data
PRED_INGEST_PATH=/data/raw/pred_ingestion/us_paro

# Processed prediction ingestion data path
PRED_PROCESSED_PATH=/data/processed/pred_ingestion/us_paro

# Final prediction output path
PRED_OUTPUT_PATH=/data/predictions/hourly/us_paro_hourly/prod

# ============================================
# Database Connection URLs
# ============================================
# Full MySQL connection URL for MLflow backend store (local)
# Format: mysql+pymysql://user:password@host:port/database_name
MYSQLURL=mysql+pymysql://root:your_mysql_password_here@host.docker.internal:3306/mlflow_backend

# Remote MySQL connection URL for MLflow backend store
MYSQLURL_REMOTE=mysql+pymysql://user:password@remote_host:port/mlflow_db

# MySQL connection URL for prediction database (local)
PRED_MYSQLURL=mysql+pymysql://root:your_mysql_password_here@host.docker.internal:3306/pypipeline_predictions

# Remote MySQL connection URL for prediction database
PRED_MYSQLURL_REMOTE=${MYSQLURI}/prediction_db

# ============================================
# Ingestion Configuration
# ============================================
# Number of hours to look back when ingesting data
INGEST_LOOKBACK_HOURS=24
